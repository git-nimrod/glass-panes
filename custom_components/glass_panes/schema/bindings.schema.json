{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Glass Panes bindings",
  "description": "Which Home Assistant entities feed which widget. Kept apart from pane layouts so a pane can be shared without sharing anyone's entities.",
  "type": "object",
  "required": ["schema_version", "bindings"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "bindings": {
      "description": "pane id -> widget id -> slot name -> value. Slot names and kinds come from widgets.json.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/slug" },
      "additionalProperties": {
        "type": "object",
        "propertyNames": { "$ref": "#/$defs/slug" },
        "additionalProperties": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/slug" },
          "additionalProperties": { "$ref": "#/$defs/value" }
        }
      }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9_]+$", "maxLength": 64 },
    "entity_id": { "type": "string", "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+$" },
    "value": {
      "description": "One entity id, or a list whose items are entity ids or rules (an empty list means nothing is bound).",
      "oneOf": [
        { "$ref": "#/$defs/entity_id" },
        {
          "type": "array",
          "maxItems": 40,
          "items": { "oneOf": [{ "$ref": "#/$defs/entity_id" }, { "$ref": "#/$defs/rule" }] }
        }
      ]
    },
    "rule": {
      "description": "A status check or a news feed: an entity plus how to treat it.",
      "type": "object",
      "required": ["entity"],
      "additionalProperties": false,
      "properties": {
        "entity": { "$ref": "#/$defs/entity_id" },
        "name": { "type": "string", "maxLength": 80 },
        "text": { "type": "string", "maxLength": 80 },
        "bad": { "type": "array", "items": { "type": "string" }, "maxItems": 20 },
        "ok": { "type": "array", "items": { "type": "string" }, "maxItems": 20 },
        "below": { "type": "number" },
        "above": { "type": "number" },
        "filter": { "enum": ["all", "keywords"] }
      }
    }
  }
}
