    "date": { "label": "Date", "slots": {} },
    "text": { "label": "Text", "slots": {} },
    "image": { "label": "Image", "slots": {} },
    "video": { "label": "Looping video", "slots": {} },
    "divider": { "label": "Divider line", "slots": {} },
    "message": {
      "label": "Message",
      "slots": {
        "entity": {
          "kind": "entity",
          "domains": ["input_text", "text", "sensor"],
