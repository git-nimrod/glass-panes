    "weather": {
      "label": "Weather",
      "slots": {
        "weather": { "kind": "entity", "domains": ["weather"], "required": true, "label": "Weather entity" }
      }
    },
    "calendar_agenda": {
      "label": "Calendar agenda",
      "slots": {
        "calendars": { "kind": "entities", "domains": ["calendar"], "required": true, "label": "Calendars" }
      }
    },
    "todo_list": {
      "label": "To-do list",
      "slots": {
        "list": { "kind": "entity", "domains": ["todo"], "required": true, "label": "To-do list" }
