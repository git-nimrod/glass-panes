<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- camera presence (Presence.kt): pictures stay on the mirror, only numbers go to Home Assistant -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- the microphone test (MicProbe.kt, GET /mic/test): loudness numbers only, nothing is recorded or sent. Like the camera, the permission is granted over adb -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- the Bluetooth test (BtProbe.kt, GET /bluetooth/test): turns Bluetooth on if needed, counts nearby advertisements, keeps no address or name.
         BLUETOOTH and BLUETOOTH_ADMIN are granted at install; the location permission (needed on Android 6 to receive scan results) is granted over adb -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Wi-Fi for a fresh mirror, handed over by the installer (WifiSetup.kt): the app adds the network to Android's own settings -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- Only granted when the app is built into the image as a privileged app (mirror-android-3 and later); ignored otherwise:
         INSTALL_PACKAGES lets it install its own updates sent by Home Assistant (AppUpdate.kt), MANAGE_DEVICE_ADMINS lets it switch on
         its own screen-off admin (SystemSetup.kt). -->
    <uses-permission android:name="android.permission.INSTALL_PACKAGES" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.MANAGE_DEVICE_ADMINS" tools:ignore="ProtectedPermissions" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
        android:usesCleartextTraffic="true"
        android:persistent="true"
        android:hardwareAccelerated="true">
        <!-- persistent: only counts for a built-in app (mirror-android-3 and later). Android then keeps the app's main process and starts
             it again if it ever dies; an app installed with adb ignores it. -->

        <!-- HOME category makes this the mirror's "home screen": Android starts it at boot
             and restarts it if it ever crashes. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service android:name=".ControlService" android:exported="false" />

        <!-- updates from Home Assistant (AppUpdate.kt): Android's installer answer, and starting the screen again after an update -->
        <receiver android:name=".UpdateReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- screen off (Screen.kt): force-lock only. Switched on by the app itself when it is built in (image 3+, SystemSetup.kt), otherwise
             once with `adb shell dpm set-active-admin com.nimrod.mirrorkiosk/.ScreenAdmin` -->
        <receiver
            android:name=".ScreenAdmin"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data android:name="android.app.device_admin" android:resource="@xml/screen_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
